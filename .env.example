# Copy this file to .env and fill in what you use. Nothing here is required except one AI provider.

# ---- The AI that picks moments --------------------------------------------
# anthropic | openai | claude-cli | command
LLM_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server. Leave OPENAI_BASE_URL empty for OpenAI itself.
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model name for whichever provider you chose. Empty means claude-opus-5-5 on anthropic,
# your default model on claude-cli; the openai provider needs one.
LLM_MODEL=
# Optional cheaper model for the yes/no editorial check ("gate" in config.json).
LLM_FAST_MODEL=

# For LLM_PROVIDER=command: any command that reads the prompt on stdin and prints the answer.
# e.g.  LLM_COMMAND=llm -m gpt-5        or   LLM_COMMAND=ollama run qwen3
LLM_COMMAND=

# ---- Transcription ---------------------------------------------------------
# local  = faster-whisper on this machine, free, no account
# openai = any OpenAI-compatible transcription API (OpenAI, Groq, ...)
TRANSCRIBER=local

# local: tiny | base | small | medium | large-v3 | turbo
WHISPER_MODEL=small

# openai: e.g. Groq is TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1, TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=whisper-1
